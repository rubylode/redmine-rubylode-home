<%# The home view: greeting, four tiles, the assigned tickets, and the side cards. home is a RubylodeHome::HomePage. %>
<% rules = home.rules %>
<% grouping = rubylode_home_grouping %>
<div class="rubylode-home" data-rubylode-home="my-page">
  <header class="rubylode-home-header">
    <div class="rubylode-home-heading">
      <p class="rubylode-home-date"><%= rubylode_home_date(home.today) %></p>
      <h2 class="rubylode-home-greeting"><%= rubylode_home_greeting(home.user) %></h2>
      <p class="rubylode-home-summary"><%= rubylode_home_summary(home.tiles) %></p>
    </div>
    <div class="rubylode-home-actions">
      <%= link_to l(:label_rubylode_home_classic_view), my_page_path(view: "classic"), class: "rubylode-home-button rubylode-home-button--quiet" %>
      <% if home.can_add_issues? %>
        <%= link_to new_issue_path, class: "rubylode-home-button rubylode-home-new-issue" do %>
          <span aria-hidden="true">+</span> <%= l(:label_issue_new) %>
        <% end %>
      <% end %>
    </div>
  </header>

  <%= render partial: "rubylode_home/tiles", locals: { tiles: home.tiles, rules: rules } %>

  <div class="rubylode-home-columns">
    <%= render partial: "rubylode_home/assigned_card", locals: { home: home, rules: rules, grouping: grouping } %>

    <div class="rubylode-home-side">
      <%= render partial: "rubylode_home/issue_card",
                 locals: { key: "due_soon", issues: home.due_soon_issues, rules: rules,
                           link: rubylode_home_tile_path(:due_this_week, rules) } %>
      <%= render partial: "rubylode_home/issue_card",
                 locals: { key: "watched", issues: home.watched_issues, rules: rules,
                           link: rubylode_home_tile_path(:watched, rules) } %>
      <%= render partial: "rubylode_home/issue_card",
                 locals: { key: "recently_updated", issues: home.recently_updated_issues, rules: rules, link: nil } %>
      <%= render partial: "rubylode_home/activity", locals: { events: home.recent_events } %>
    </div>
  </div>
</div>
