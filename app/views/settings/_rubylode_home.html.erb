<% if @validation_errors.present? %>
  <div id="errorExplanation" class="rubylode-home-errors">
    <ul>
      <% @validation_errors.each do |message| %><li><%= message %></li><% end %>
    </ul>
  </div>
<% end %>
<% scope = "rubylode_home.settings" %>
<% value_of = ->(key) { settings[key].nil? ? RubylodeHome::Settings::DEFAULTS[key] : settings[key] } %>

<p>
  <label for="settings_welcome_page_content"><%= l("#{scope}.welcome_page_content.label") %></label>
  <%= select_tag "settings[welcome_page_content]",
                 options_for_select(RubylodeHome::Settings::WELCOME_PAGE_CONTENTS.map { |choice| [l("#{scope}.welcome_page_content.choices.#{choice}"), choice] },
                                    value_of.call("welcome_page_content")),
                 id: "settings_welcome_page_content" %>
  <em class="info"><%= l("#{scope}.welcome_page_content.hint") %></em>
</p>

<p>
  <label for="settings_welcome_page_column"><%= l("#{scope}.welcome_page_column.label") %></label>
  <%= select_tag "settings[welcome_page_column]",
                 options_for_select(RubylodeHome::Settings::COLUMNS.map { |choice| [l("#{scope}.welcome_page_column.choices.#{choice}"), choice] },
                                    value_of.call("welcome_page_column")),
                 id: "settings_welcome_page_column" %>
  <em class="info"><%= l("#{scope}.welcome_page_column.hint") %></em>
</p>

<p>
  <label for="settings_dates_without_times"><%= l("#{scope}.dates_without_times.label") %></label>
  <%= hidden_field_tag "settings[dates_without_times]", "0", id: nil %>
  <%= check_box_tag "settings[dates_without_times]", "1", value_of.call("dates_without_times").to_s == "1", id: "settings_dates_without_times" %>
  <em class="info"><%= l("#{scope}.dates_without_times.hint") %></em>
</p>
